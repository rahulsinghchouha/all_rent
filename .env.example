# Docker Compose configuration. Copy these entries into your local .env file.
# Use URL-safe characters for POSTGRES_PASSWORD because it is embedded in DATABASE_URL.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-a-strong-url-safe-password
POSTGRES_DB=all_rent

# Use the same credentials for the MinIO server and the application.
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=replace-with-a-strong-minio-password
MINIO_BUCKET=rental-images
MINIO_PUBLIC_URL=http://localhost:9000

# Replace both values with long, random secrets.
ACCESS_TOKEN_SECRET=replace-with-a-long-random-access-token-secret
REFRESH_TOKEN_SECRET=replace-with-a-long-random-refresh-token-secret
